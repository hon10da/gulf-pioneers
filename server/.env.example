# Gulf Pioneers - Server Environment Variables (Example)
# انسخ هذا الملف إلى .env وضع القيم الحقيقية هناك (.env لا يُرفع على Git)

# ---- General ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string (احصل عليه من Atlas Dashboard الخاص بك)
MONGODB_URI=

# ---- Auth / JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Admin Seed ----
# يُستخدم فقط عند تشغيل: npm run seed:admin
# لا تضع قيم حقيقية هنا في هذا الملف (.example) — فقط في .env المحلي الخاص بك
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary (سيُستخدم في مرحلة إدارة الصور - Gallery/Services) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
